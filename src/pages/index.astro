---
import { getCollection } from "astro:content";
import PostList from "../components/PostList.astro";
import Page from "../layouts/Page.astro";

const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const lifePosts = allPosts.filter((post) => post.data.category === "life");
const workPosts = allPosts.filter((post) => post.data.category === "work");
---

<Page title="Shariq Attar" description="engineer. currently doing whatever.">
    <main class="p-6 sm:p-10">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
            <div class="md:col-span-7 space-y-5 z-10 flex flex-col">
                <h1 class="text-4xl sm:text-5xl font-black text-[#2e1a0b] tracking-tight leading-tight [text-shadow:2px_3px_4px_rgba(40,25,10,0.35)]">
                    shariq attar.
                </h1>
                <p class="text-base sm:text-lg text-[#523419] font-medium leading-relaxed max-w-xs">
                    i build things, think too much,
                    <br />
                    and occasionally write about it.
                </p>
                <p class="text-sm text-[#735232] italic">
                    software — philosophy — whatever else catches my eye.
                </p>
                <a
                    href="#writings"
                    class="inline-flex items-center gap-2 text-sm font-bold text-[#7c2d12] italic hover:gap-3 transition-all duration-200"
                    onclick="document.getElementById('writings').scrollIntoView({behavior:'smooth'}); return false;"
                >
                    ↓ read the writing
                </a>
            </div>

            <div class="md:col-span-5 flex justify-center">
                <div class="relative w-64 sm:w-72">
                    <svg
                        class="absolute -top-6 -left-10 w-full h-full pointer-events-none text-[#523419] opacity-40 hidden sm:block"
                        viewBox="0 0 200 200"
                        fill="none"
                    >
                        <path
                            d="M 20 180 C 20 20, 180 20, 180 140 C 180 180, 80 180, 80 140"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                        />
                    </svg>

                    <img
                        src="/profilepic.jpg"
                        alt="an anime portrait"
                        class="w-full h-auto rounded-sm filter contrast-125 brightness-95 drop-shadow-[4px_6px_10px_rgba(0,0,0,0.5)] border border-[#caa368]"
                    />
                </div>
            </div>
        </div>

        <hr class="border-t-2 border-[#d6ba7f] my-10" />

        <section id="writings" class="space-y-6 scroll-mt-6">
            <div class="flex items-center justify-between border-b-2 border-[#caa368] pb-2">
                <h2 class="text-xl sm:text-2xl font-bold italic text-[#8a3e14] [text-shadow:1px_1px_2px_rgba(0,0,0,0.15)]">
                    notes
                </h2>

                <div class="flex gap-2">
                    <button
                        class="tab-btn px-3 py-1 text-xs font-bold transition-colors border border-[#2b180a] cursor-pointer"
                        data-tab="life"
                        data-active="true"
                    >
                        life ({lifePosts.length})
                    </button>
                    <button
                        class="tab-btn px-3 py-1 text-xs font-bold transition-colors border border-[#2b180a] cursor-pointer"
                        data-tab="work"
                        data-active="false"
                    >
                        work ({workPosts.length})
                    </button>
                </div>
            </div>

            <div data-tab-panel="life">
                <PostList posts={lifePosts} />
            </div>

            <div data-tab-panel="work" hidden>
                <PostList posts={workPosts} />
            </div>
        </section>
    </main>
</Page>

<script>
    const tabs = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
    const panels = document.querySelectorAll<HTMLElement>("[data-tab-panel]");

    tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
            tabs.forEach((candidate) => {
                candidate.dataset.active = String(candidate === tab);
            });

            panels.forEach((panel) => {
                panel.hidden = panel.dataset.tabPanel !== tab.dataset.tab;
            });
        });
    });
</script>
