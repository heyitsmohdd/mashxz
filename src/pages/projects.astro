---
import CornerRail from "../components/CornerRail.astro";
import Page from "../layouts/Page.astro";

const projects = [
    {
        name: "Silo",
        description: "a forum for your batch.",
        url: "https://siloedu.vercel.app/welcome",
    },
    {
        name: "Focuswaqt",
        description: "a pomodoro timer i built to help myself focus.",
        url: "https://focuswaqt.space",
    },
];
---

<Page title="builds — mashxz.com">
    <div class="flex flex-col md:flex-row">
        <CornerRail />

        <main class="flex-1 p-6 sm:p-10 space-y-6">
            <div class="pb-4 border-b-2 border-[#d6ba7f]">
                <h1 class="text-3xl sm:text-4xl font-black text-[#2e1a0b] tracking-tight [text-shadow:2px_3px_4px_rgba(40,25,10,0.35)]">
                    builds
                </h1>
            </div>

            <hr class="border-t border-[#caa368]" />

            <ul class="divide-y divide-[#e3d8be]">
                {projects.map((project) => (
                    <li class="py-3">
                        <div class="flex items-baseline gap-2">
                            <span class="text-[#8a3e14] font-bold select-none">
                                »
                            </span>
                            <a
                                href={project.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#0000cc] hover:underline font-bold text-base"
                            >
                                {project.name}
                            </a>
                        </div>
                        <p class="text-sm text-[#523419] mt-1 ml-6">
                            {project.description}
                        </p>
                    </li>
                ))}
            </ul>
        </main>
    </div>
</Page>
