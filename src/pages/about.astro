---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Personal site of Shariq Attar" />
    <title>About — mashxz.com</title>
  </head>
  <body class="bg-[#555d65] text-[#222220] font-sans antialiased min-h-screen py-4 sm:py-8 px-2 sm:px-4">
    <div class="max-w-4xl mx-auto shadow-2xl border border-[#2b180a] bg-[#f5f3ec] overflow-hidden">
      
      <!-- Top Wheat Banner Strip -->
      <header class="bg-[#caa368] border-b-2 border-[#38200e] px-4 py-2 flex items-center justify-between text-xs font-bold text-[#38200e] select-none">
        <nav class="flex items-center gap-3 sm:gap-6 flex-wrap [text-shadow:1px_1px_2px_rgba(0,0,0,0.25)]">
          <a href="/" class="hover:underline text-[#2e1a0b]">writing</a>
          <a href="https://github.com/heyitsmohdd" target="_blank" rel="noopener noreferrer" class="hover:underline text-[#2e1a0b]">github</a>
          <a href="mailto:mashxz@poke.com" class="hover:underline text-[#2e1a0b]">gmail</a>
        </nav>
      </header>

      <!-- Inside Page Layout with Left Corner Rail -->
      <div class="flex flex-col md:flex-row relative">
        
        <!-- Left Corner Rail (Tom Platz style) -->
        <aside class="md:w-56 bg-[#e8e4d8] border-b md:border-b-0 md:border-r border-[#caa368] p-4 flex flex-col justify-between shrink-0 relative overflow-hidden">
          
          <div class="space-y-4">
            <!-- Left Quick Links -->
            <div class="space-y-2 text-xs font-semibold text-[#523419]">
              <p class="text-[11px] uppercase tracking-wider text-[#8a3e14] font-bold border-b border-[#caa368] pb-1">
                Navigation
              </p>
              <ul class="space-y-1.5 pl-1">
                <li><a href="/" class="text-[#0000cc] hover:underline">« Return to Home</a></li>
                <li><a href="/" class="text-[#0000cc] hover:underline">» notes</a></li>
                <li><a href="mailto:mashxz@poke.com" class="text-[#0000cc] hover:underline">» email me</a></li>
              </ul>
            </div>
          </div>

        </aside>

        <!-- Main Profile Info -->
        <main class="flex-1 p-6 sm:p-10 space-y-6 bg-[#f5f3ec]">
          
          <!-- Name + Photo Header -->
          <div class="flex items-center justify-between gap-6 pb-4 border-b-2 border-[#d6ba7f]">
            <h1 class="text-3xl sm:text-4xl font-black text-[#2e1a0b] tracking-tight [text-shadow:2px_3px_4px_rgba(40,25,10,0.35)]">
              Shariq Attar
            </h1>
            <!-- Retro Round Image Placeholder -->
            <div class="shrink-0 w-24 h-24 sm:w-28 sm:h-28 rounded-full border-4 border-[#caa368] shadow-[3px_4px_8px_rgba(0,0,0,0.35)] bg-[#e8e4d8] flex items-center justify-center overflow-hidden">
              <span class="text-[#caa368] text-xs font-bold italic text-center leading-tight px-2">photo<br/>here</span>
            </div>
          </div>

          <hr class="border-t border-[#caa368]" />

          <!-- Tom Platz Style Sectional Cards -->
          <div class="space-y-8">
            
            <!-- Section 1: Spirit -->
            <section class="space-y-2">
              <h2 class="text-lg font-bold italic text-[#8a3e14]">about</h2>
              <div class="bg-[#ebe6d8] border border-[#caa368] p-4 text-sm leading-relaxed text-[#2e1a0b] rounded-[2px]">
                <p class="italic font-medium">
                  "building, tinkering, and trying to solve problems."
                </p>
              </div>
            </section>

            <!-- Section 2: Mind -->
            <section class="space-y-2">
              <h2 class="text-lg font-bold italic text-[#8a3e14]">into</h2>
              <div class="bg-[#ebe6d8] border border-[#caa368] p-4 text-sm leading-relaxed text-[#2e1a0b] rounded-[2px]">
                <p>
                  software, philosophy, history — sometimes i write.
                </p>
              </div>
            </section>

            <!-- Section 3: Connectivity -->
            <section class="space-y-2">
              <h2 class="text-lg font-bold italic text-[#8a3e14]">links</h2>
              <table class="w-full text-left border-collapse text-xs sm:text-sm">
                <tbody class="divide-y divide-[#dcd2ba]">
                  <tr>
                    <td class="py-2.5 font-bold text-[#8a3e14] w-28 align-top">GitHub:</td>
                    <td class="py-2.5">
                      <a
                        href="https://github.com/heyitsmohdd"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[#0000cc] underline font-semibold"
                      >
                        github.com/heyitsmohdd ↗
                      </a>
                    </td>
                  </tr>
                  <tr>
                    <td class="py-2.5 font-bold text-[#8a3e14] align-top">E-Mail:</td>
                    <td class="py-2.5">
                      <a
                        href="mailto:mashxz@poke.com"
                        class="text-[#0000cc] underline font-semibold"
                      >
                        mashxz@poke.com ↗
                      </a>
                    </td>
                  </tr>
                </tbody>
              </table>
            </section>

          </div>

          <hr class="border-t-2 border-[#d6ba7f] mt-8" />

        </main>

      </div>



    </div>
  </body>
</html>
