---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Personal site of Shariq Attar" />
    <title>About — Shariq Attar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0e0e0c] text-[#d6d6cb] antialiased selection:bg-[#22c55e] selection:text-black min-h-screen py-6 sm:py-12 px-3 sm:px-6">
    <div class="max-w-3xl mx-auto">
      
      <!-- Hacker News Style Container Box -->
      <div class="bg-[#151513] border border-[#272723] rounded-sm shadow-xl overflow-hidden">
        
        <!-- Top HN Nav Bar -->
        <header class="bg-[#1f1f1b] border-b border-[#2b2b26] px-3 sm:px-4 py-2 flex items-center justify-between font-mono text-xs">
          <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
            <a
              href="/"
              class="w-5 h-5 bg-[#22c55e] text-black font-bold flex items-center justify-center text-[11px] leading-none rounded-[1px] hover:opacity-90 transition-opacity"
              title="Return to blog"
            >
              M
            </a>
            <a href="/" class="font-bold text-[#f5f5f0] hover:text-[#4ade80] transition-colors">
              mashxz
            </a>
            <span class="text-[#45453e]">|</span>
            <nav class="flex items-center gap-2 text-[#99998e]">
              <a href="/about" class="text-[#f5f5f0] hover:underline font-semibold">about</a>
              <span class="text-[#45453e]">|</span>
              <a href="/" class="hover:text-[#f5f5f0] hover:underline">blog</a>
            </nav>
          </div>

          <div class="hidden sm:flex items-center gap-2 text-[#7f7f75] font-mono text-xs">
            <a href="https://github.com/heyitsmohdd" target="_blank" rel="noopener noreferrer" class="hover:text-[#f5f5f0] hover:underline">
              github
            </a>
          </div>
        </header>

        <!-- Main Profile Info -->
        <main class="p-6 sm:p-10 space-y-8 font-mono">
          <section class="border-b border-[#262622] pb-6">
            <h1 class="text-2xl sm:text-3xl font-semibold text-[#f5f5f0] font-sans">
              Shariq Attar
            </h1>
          </section>

          <!-- Retro Bio / Details Table -->
          <section class="space-y-4 text-xs text-[#cecec2]">
            <table class="w-full text-left border-collapse">
              <tbody class="divide-y divide-[#22221e]">
                <tr>
                  <td class="py-2.5 text-[#737368] w-28 align-top">about:</td>
                  <td class="py-2.5 text-[#deded4] font-sans leading-relaxed text-sm">
                    building, tinkering, and trying to solve problems.
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 text-[#737368] align-top">github:</td>
                  <td class="py-2.5">
                    <a
                      href="https://github.com/heyitsmohdd"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[#4ade80] hover:underline"
                    >
                      github.com/heyitsmohdd ↗
                    </a>
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 text-[#737368] align-top">email:</td>
                  <td class="py-2.5">
                    <a
                      href="mailto:mashxz@poke.com"
                      class="text-[#4ade80] hover:underline"
                    >
                      mashxz@poke.com ↗
                    </a>
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 text-[#737368] align-top">interests:</td>
                  <td class="py-2.5 text-[#a8a89c]">
                    software, philosophy, history, sometimes i write
                  </td>
                </tr>
              </tbody>
            </table>
          </section>

        </main>

      </div>
    </div>
  </body>
</html>
