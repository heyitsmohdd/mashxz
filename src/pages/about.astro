---
import CornerRail from "../components/CornerRail.astro";
import Page from "../layouts/Page.astro";
---

<Page title="About — mashxz.com">
    <div class="flex flex-col md:flex-row relative">
        <CornerRail />

        <main class="flex-1 p-6 sm:p-10 space-y-6 bg-[#f5f3ec]">
            <div class="flex items-center justify-between gap-6 pb-4 border-b-2 border-[#d6ba7f]">
                <h1 class="text-3xl sm:text-4xl font-black text-[#2e1a0b] tracking-tight [text-shadow:2px_3px_4px_rgba(40,25,10,0.35)]">
                    Shariq Attar
                </h1>
                <div class="shrink-0 w-24 h-24 sm:w-28 sm:h-28 rounded-full border-4 border-[#caa368] shadow-[3px_4px_8px_rgba(0,0,0,0.35)] bg-[#e8e4d8] flex items-center justify-center overflow-hidden">
                    <span class="text-[#caa368] text-xs font-bold italic text-center leading-tight px-2">
                        photo
                        <br />
                        here
                    </span>
                </div>
            </div>

            <hr class="border-t border-[#caa368]" />

            <div class="space-y-8">
                <section class="space-y-2">
                    <h2 class="text-lg font-bold italic text-[#8a3e14]">
                        about
                    </h2>
                    <div class="bg-[#ebe6d8] border border-[#caa368] p-4 text-sm leading-relaxed text-[#2e1a0b] rounded-[2px]">
                        <p class="italic font-medium">
                            "building, tinkering, and trying to solve problems."
                        </p>
                    </div>
                </section>

                <section class="space-y-2">
                    <h2 class="text-lg font-bold italic text-[#8a3e14]">
                        into
                    </h2>
                    <div class="bg-[#ebe6d8] border border-[#caa368] p-4 text-sm leading-relaxed text-[#2e1a0b] rounded-[2px]">
                        <p>
                            software, philosophy, history — sometimes i write.
                        </p>
                    </div>
                </section>

                <section class="space-y-2">
                    <h2 class="text-lg font-bold italic text-[#8a3e14]">
                        links
                    </h2>
                    <table class="w-full text-left border-collapse text-xs sm:text-sm">
                        <tbody class="divide-y divide-[#dcd2ba]">
                            <tr>
                                <td class="py-2.5 font-bold text-[#8a3e14] w-28 align-top">
                                    GitHub:
                                </td>
                                <td class="py-2.5">
                                    <a
                                        href="https://github.com/heyitsmohdd"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-[#0000cc] underline font-semibold"
                                    >
                                        github.com/heyitsmohdd ↗
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td class="py-2.5 font-bold text-[#8a3e14] align-top">
                                    E-Mail:
                                </td>
                                <td class="py-2.5">
                                    <a
                                        href="mailto:mashxz@poke.com"
                                        class="text-[#0000cc] underline font-semibold"
                                    >
                                        mashxz@poke.com ↗
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </section>
            </div>

            <hr class="border-t-2 border-[#d6ba7f] mt-8" />
        </main>
    </div>
</Page>
