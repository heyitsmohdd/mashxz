---
import { getCollection, render } from "astro:content";
import CornerRail from "../components/CornerRail.astro";
import Page from "../layouts/Page.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Page title={`${post.data.title} — mashxz.com`}>
    <div class="flex flex-col md:flex-row">
        <CornerRail />

        <main class="flex-1 p-6 sm:p-10 space-y-6">
            <header class="space-y-2">
                <h1 class="text-2xl sm:text-3xl font-black italic text-[#8a3e14] [text-shadow:1px_1px_2px_rgba(0,0,0,0.15)]">
                    {post.data.title}
                </h1>
                <div class="flex items-center gap-2 text-xs font-semibold text-[#6e5138]">
                    <time datetime={post.data.date.toISOString()}>
                        {post.data.date.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })}
                    </time>
                    <span>•</span>
                    <span class="text-[#8a3e14]">[{post.data.category}]</span>
                </div>
            </header>

            <hr class="border-t border-[#caa368]" />

            <article
                class="prose prose-neutral max-w-none text-[#222220] leading-relaxed text-[17px] font-sans
            prose-p:mb-5
            prose-headings:font-bold
            prose-headings:italic
            prose-headings:text-[#8a3e14]
            prose-a:text-[#0000cc]
            prose-a:underline
            prose-blockquote:border-l-4
            prose-blockquote:border-[#caa368]
            prose-blockquote:bg-[#ece8dc]
            prose-blockquote:py-2
            prose-blockquote:px-4
            prose-blockquote:text-[#523419]
            prose-blockquote:italic
            prose-strong:text-[#2e1a0b]"
            >
                <Content />
            </article>

            <hr class="border-t-2 border-[#d6ba7f] mt-10" />

            <section class="bg-[#ebe6d8] border border-[#caa368] p-4 text-xs text-[#523419] rounded-[2px] space-y-1">
                <p class="font-bold text-[#8a3e14]">thoughts</p>
                <p>
                    i read these.{" "}
                    <a
                        href={`mailto:mashxz@poke.com?subject=Thoughts%20on%20${encodeURIComponent(post.data.title)}`}
                        class="text-[#0000cc] underline font-semibold"
                    >
                        mashxz@poke.com
                    </a>
                </p>
            </section>
        </main>
    </div>
</Page>
