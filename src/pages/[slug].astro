---
import "../styles/global.css";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.id.replace(/\.md$/, "") },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            name="description"
            content={post.data.description || post.data.title}
        />
        <title>{post.data.title} — mashxz.com</title>
    </head>
    <body class="bg-[#555d65] text-[#222220] font-sans antialiased min-h-screen py-4 sm:py-8 px-2 sm:px-4">
        <div class="max-w-4xl mx-auto shadow-2xl border border-[#2b180a] bg-[#f5f3ec] overflow-hidden">
            <!-- Top Wheat Banner Strip (Tom Platz 2001 style) -->
            <header class="bg-[#caa368] border-b-2 border-[#38200e] px-4 py-2 flex items-center justify-between text-xs font-bold text-[#38200e] select-none">
                <nav class="flex items-center gap-3 sm:gap-6 flex-wrap [text-shadow:1px_1px_2px_rgba(0,0,0,0.25)]">
                    <a href="/" class="hover:underline text-[#2e1a0b]">
                        writing
                    </a>
                    <a
                        href="https://github.com/heyitsmohdd"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:underline text-[#2e1a0b]"
                    >
                        github
                    </a>
                    <a
                        href="mailto:mashxz@poke.com"
                        class="hover:underline text-[#2e1a0b]"
                    >
                        gmail
                    </a>
                </nav>
            </header>

            <!-- Inside Page Layout with Vintage Left Corner Rail -->
            <div class="flex flex-col md:flex-row relative">
                <!-- Left 2001 Corner Rail (Tom Platz style) -->
                <aside class="md:w-56 bg-[#e8e4d8] border-b md:border-b-0 md:border-r border-[#caa368] p-4 flex flex-col justify-between shrink-0 relative overflow-hidden">
                    <div class="space-y-4">
                        <!-- Left Quick Links -->
                        <div class="space-y-2 text-xs font-semibold text-[#523419]">
                            <p class="text-[11px] uppercase tracking-wider text-[#8a3e14] font-bold border-b border-[#caa368] pb-1">
                                Navigation
                            </p>
                            <ul class="space-y-1.5 pl-1">
                                <li>
                                    <a
                                        href="/"
                                        class="text-[#0000cc] hover:underline"
                                    >
                                        « Back to Index
                                    </a>
                                </li>
                                <li>
                                    <a
                                        href="mailto:mashxz@poke.com"
                                        class="text-[#0000cc] hover:underline"
                                    >
                                        » email me
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </aside>

                <!-- Main Essay Content Area -->
                <main class="flex-1 p-6 sm:p-10 space-y-6 bg-[#f5f3ec]">
                    <header class="space-y-2">
                        <h1 class="text-2xl sm:text-3xl font-black italic text-[#8a3e14] [text-shadow:1px_1px_2px_rgba(0,0,0,0.15)]">
                            {post.data.title}
                        </h1>
                        <div class="flex items-center gap-2 text-xs font-semibold text-[#6e5138]">
                            <time datetime={post.data.date.toISOString()}>
                                {post.data.date.toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric",
                                })}
                            </time>
                            <span>•</span>
                            <span class="text-[#8a3e14]">
                                [{post.data.category}]
                            </span>
                        </div>
                    </header>

                    <hr class="border-t border-[#caa368]" />

                    <!-- Main Article Prose -->
                    <article
                        class="prose prose-neutral max-w-none text-[#222220] leading-relaxed text-[17px] font-sans
            prose-p:mb-5
            prose-headings:font-bold
            prose-headings:italic
            prose-headings:text-[#8a3e14]
            prose-a:text-[#0000cc]
            prose-a:underline
            prose-blockquote:border-l-4
            prose-blockquote:border-[#caa368]
            prose-blockquote:bg-[#ece8dc]
            prose-blockquote:py-2
            prose-blockquote:px-4
            prose-blockquote:text-[#523419]
            prose-blockquote:italic
            prose-strong:text-[#2e1a0b]"
                    >
                        <Content />
                    </article>

                    <hr class="border-t-2 border-[#d6ba7f] mt-10" />

                    <!-- Casual End Note -->
                    <section class="bg-[#ebe6d8] border border-[#caa368] p-4 text-xs text-[#523419] rounded-[2px] space-y-1">
                        <p class="font-bold text-[#8a3e14]">
                            Reflections & Correspondence:
                        </p>
                        <p>
                            Feel free to send your thoughts or reflections
                            directly to
                            <a
                                href={`mailto:mashxz@poke.com?subject=Thoughts%20on%20${encodeURIComponent(post.data.title)}`}
                                class="text-[#0000cc] underline font-semibold"
                            >
                                mashxz@poke.com
                            </a>
                        </p>
                    </section>
                </main>
            </div>
        </div>
    </body>
</html>
