---
import type { CollectionEntry } from "astro:content";

interface Props {
    posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;

const getSlug = (post: CollectionEntry<"blog">) => post.id.replace(/\.md$/, "");
---

{posts.length === 0 ? (
    <p class="text-[#735232] text-sm py-4 italic">Nothing yet.</p>
) : (
    <ul class="divide-y divide-[#e3d8be]">
        {posts.map((post) => (
            <li class="py-3 flex items-baseline justify-between gap-4 flex-wrap group">
                <div class="flex items-baseline gap-2">
                    <span class="text-[#8a3e14] font-bold select-none">»</span>
                    <a
                        href={`/${getSlug(post)}`}
                        class="text-[#0000cc] hover:underline font-bold text-base transition-colors"
                    >
                        {post.data.title}
                    </a>
                    <span class="text-xs text-[#6e5138]">
                        ({getSlug(post)})
                    </span>
                </div>

                <div class="flex items-center gap-2 text-xs text-[#6e5138]">
                    <time datetime={post.data.date.toISOString()}>
                        {post.data.date.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "short",
                            day: "numeric",
                        })}
                    </time>
                    <span>•</span>
                    <span class="text-[#8a3e14] font-semibold">
                        [{post.data.category}]
                    </span>
                </div>
            </li>
        ))}
    </ul>
)}
